#version 450

layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 0) buffer InputBuffer 
{
    float i[];
} inputBuffer;

layout(std430, set = 0, binding = 1) buffer OutputBuffer 
{
    float o[];
} outputBuffer;

void main() 
{
    int id = int(gl_GlobalInvocationID.x);
    outputBuffer.o[id] = inputBuffer.i[id];
}