#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, set = 0, binding = 0) buffer InputBuffer
{
    vec4 area;
    vec4 cellSize;
    vec4 center;
    
    vec4 diff;
    float mapCount;
    float loud;
    float roughness;
    float persistance;
} inputBuffer;

layout(std430, set = 0, binding = 1) buffer OutputBuffer
{
    vec4 vertices[];
} outputBuffer;

uint ToIndex(vec3 area, uint x, uint y, uint z)
{
    return z * (uint(area.x) + 1) * (uint(area.y) + 1) + y * (uint(area.x) + 1) + x;
}

const vec3 G[12] = vec3[12]
(
    vec3( 1,  1,  0),
    vec3(-1,  1,  0),
    vec3( 1, -1,  0),
    vec3(-1, -1,  0),
    vec3( 1,  0,  1),
    vec3(-1,  0,  1),
    vec3( 1,  0, -1),
    vec3(-1,  0, -1),
    vec3( 0,  1,  1),
    vec3( 0, -1,  1),
    vec3( 0,  1, -1),
    vec3( 0, -1, -1)
);

// 伪随机数生成函数，基于输入的整数坐标和种子
int Random(ivec3 p, int seed)
{
    int h = int(dot(p, ivec3(1, 57, 113)));  // 使用不同的常数混合
    h = (h ^ (h >> 16)) * 0x45d9f3b;
    h = (h ^ (h >> 16)) * 0x45d9f3b;
    h = h ^ (h >> 16);  // 哈希运算
    
    // 使用种子来影响哈希结果
    h = h + seed;
    
    // 返回 0-15 之间的值，用于从梯度表选择
    return h & 15;
}

float Fade(float t)
{
    return t * t * t * (t * (t * 6 - 15) + 10);
}

float PerlinNoise3D(vec3 p, int seed)
{
    ivec3 p0 = ivec3(floor(p.x), floor(p.y), floor(p.z));
    ivec3 p1 = ivec3(p0.x + 1, p0.y, p0.z);
    ivec3 p2 = ivec3(p0.x, p0.y + 1, p0.z);
    ivec3 p3 = ivec3(p0.x + 1, p0.y + 1, p0.z);
    ivec3 p4 = ivec3(p0.x, p0.y, p0.z + 1);
    ivec3 p5 = ivec3(p0.x + 1, p0.y, p0.z + 1);
    ivec3 p6 = ivec3(p0.x, p0.y + 1, p0.z + 1);
    ivec3 p7 = ivec3(p0.x + 1, p0.y + 1, p0.z + 1);

    vec3 g0 = G[Random(p0, seed)];
    vec3 g1 = G[Random(p1, seed)];
    vec3 g2 = G[Random(p2, seed)];
    vec3 g3 = G[Random(p3, seed)];
    vec3 g4 = G[Random(p4, seed)];
    vec3 g5 = G[Random(p5, seed)];
    vec3 g6 = G[Random(p6, seed)];
    vec3 g7 = G[Random(p7, seed)];

    vec3 dir0 = p - p0;
    vec3 dir1 = p - p1;
    vec3 dir2 = p - p2;
    vec3 dir3 = p - p3;
    vec3 dir4 = p - p4;
    vec3 dir5 = p - p5;
    vec3 dir6 = p - p6;
    vec3 dir7 = p - p7;

    float product0 = dot(g0, dir0);
    float product1 = dot(g1, dir1);
    float product2 = dot(g2, dir2);
    float product3 = dot(g3, dir3);
    float product4 = dot(g4, dir4);
    float product5 = dot(g5, dir5);
    float product6 = dot(g6, dir6);
    float product7 = dot(g7, dir7);

    float tX = Fade(dir0.x);
    float tY = Fade(dir0.y);
    float tZ = Fade(dir0.z);

    return mix(
        mix(mix(product0, product1, tX), mix(product2, product3, tX), tY),
        mix(mix(product4, product5, tX), mix(product6, product7, tX), tY), tZ);
}

void main()
{
    uvec3 id = gl_GlobalInvocationID;
    
    vec3 area = inputBuffer.area.xyz;
    if (id.x > area.x || id.y > area.y || id.z > area.z)
    {
        return;
    }
    
    vec3 cellSize = inputBuffer.cellSize.xyz;
    vec3 center = inputBuffer.center.xyz;

    uint index = ToIndex(area, id.x, id.y, id.z);
    vec3 pos = center + id * cellSize - vec3((area.x + 1) * cellSize.x, (area.y + 1) * cellSize.y, (area.z + 1) * cellSize.z) * 0.5;

    //noise
    vec3 mapPos = pos * inputBuffer.diff.xyz;
    float noise = 0;
    float frequency = 1;
    float factor = 1;
    for (uint i = 0; i < uint(inputBuffer.mapCount); i++)
    {
        vec3 layerValue = mapPos * frequency;
        noise = noise + PerlinNoise3D(layerValue, 0) * factor;
        factor *= inputBuffer.persistance;
        frequency *= inputBuffer.roughness;
    }

    outputBuffer.vertices[index] = vec4(pos, noise + pos.y * inputBuffer.loud);
}